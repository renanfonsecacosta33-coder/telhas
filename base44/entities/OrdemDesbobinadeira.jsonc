{
  "name": "OrdemDesbobinadeira",
  "type": "object",
  "properties": {
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade produtora"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data de produ\u00e7\u00e3o planejada"
    },
    "maquina_inicial": {
      "type": "string",
      "description": "M\u00e1quina inicial escolhida no formul\u00e1rio din\u00e2mico (ex: DESBOBINADEIRA 01, DESBOBINADEIRA 02, CORTE 3M, DOBRA 3M...)",
      "default": "DESBOBINADEIRA 01"
    },
    "maquina": {
      "type": "string",
      "enum": [
        "DESBOBINADEIRA 01",
        "DESBOBINADEIRA 02",
        "DESBOBINADEIRA"
      ],
      "default": "DESBOBINADEIRA 01",
      "description": "M\u00e1quina respons\u00e1vel: DESBOBINADEIRA 01 (bobinas at\u00e9 3,00mm) ou DESBOBINADEIRA 02 (bobinas at\u00e9 4,75mm)"
    },
    "bobina_id": {
      "type": "string",
      "description": "ID da bobina do estoque CD"
    },
    "bobina_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da bobina (snapshot: c\u00f3digo, cor, espessura utilizada)"
    },
    "espessura_utilizada": {
      "type": "string",
      "description": "Espessura utilizada da bobina (snapshot)"
    },
    "espessura_exigida": {
      "type": "string",
      "description": "Espessura exigida pelo pedido Odoo (trava de seguran\u00e7a) \u2014 ex: 1,30"
    },
    "origem_exigida": {
      "type": "string",
      "enum": [
        "ambas",
        "Nacional",
        "Importado"
      ],
      "default": "ambas",
      "description": "Origem do a\u00e7o exigida pelo pedido Odoo (trava Nacional/Importado)"
    },
    "tipo_peca": {
      "type": "string",
      "description": "Tipo de pe\u00e7a do item da OF (snapshot)"
    },
    "produto": {
      "type": "string",
      "description": "Nome do produto do item da OF (snapshot)"
    },
    "item_produto": {
      "type": "string",
      "description": "Nome exato do produto do item Odoo (usado no v\u00ednculo OP \u2194 item)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do item da OF (snapshot)"
    },
    "instrucao": {
      "type": "string",
      "description": "Instru\u00e7\u00e3o de produ\u00e7\u00e3o herdada do item / vendedor"
    },
    "observacao_vendedor": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do vendedor para a produ\u00e7\u00e3o"
    },
    "chapa_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da chapa / pe\u00e7a a produzir (snapshot)"
    },
    "dimensoes_livres": {
      "type": "string",
      "description": "Dimens\u00f5es livres da pe\u00e7a (ex: 100x50x3m)"
    },
    "comprimento_mm": {
      "type": "number",
      "description": "Comprimento de corte em mm"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade de pe\u00e7as a cortar"
    },
    "quantidade_pecas": {
      "type": "number",
      "description": "Quantidade de pe\u00e7as (quando a quantidade comercial \u00e9 em KG)"
    },
    "peso_kg": {
      "type": "number",
      "description": "Peso em kg da OP"
    },
    "kg_estimado": {
      "type": "number",
      "description": "KG estimado a ser consumido da bobina"
    },
    "destino": {
      "type": "string",
      "enum": [
        "estoque",
        "pedido_direto"
      ],
      "default": "estoque",
      "description": "Destino das chapas: estoque (chaparia) ou pedido direto"
    },
    "pedido_odoo_id": {
      "type": "string",
      "description": "ID da OF (PedidoOdoo) que originou esta OP \u2014 v\u00ednculo exato usado pelo PCP"
    },
    "of_odoo_id": {
      "type": "string",
      "description": "ID da OF no Odoo (mrp.production)"
    },
    "of_nome": {
      "type": "string",
      "description": "Nome vis\u00edvel da OF no Odoo (ex: WH/MO/406632)"
    },
    "item_idx": {
      "type": "number",
      "description": "\u00cdndice do item dentro do itens_json da OF"
    },
    "itens_indices": {
      "type": "string",
      "description": "JSON array com todos os \u00edndices de itens da OF cobertos por esta OP"
    },
    "roteiro_maquinas": {
      "type": "string",
      "description": "JSON array com o roteiro de m\u00e1quinas definido pelo PCP (ex: [\"DESBOBINADEIRA 01\",\"CORTE 3M\"])"
    },
    "indice_etapa_atual": {
      "type": "number",
      "description": "\u00cdndice da etapa atual dentro do roteiro de m\u00e1quinas"
    },
    "numero_pedido": {
      "type": "string",
      "description": "N\u00famero do pedido (quando destino = pedido_direto)"
    },
    "numero_oc": {
      "type": "string",
      "description": "N\u00famero da OC / Ordem de Compra de sistema legado associada ao pedido"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente (quando destino = pedido_direto)"
    },
    "vendedor": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel pela venda do pedido"
    },
    "guilhotina": {
      "type": "string",
      "enum": [
        "CORTE 3M",
        "CORTE 6M"
      ],
      "description": "Guilhotina para onde a chapa ser\u00e1 enviada"
    },
    "tamanho_corte_guilhotina": {
      "type": "number",
      "description": "Tamanho de corte na guilhotina em mm"
    },
    "valor_pago_cliente": {
      "type": "number",
      "description": "Valor pago pelo cliente (R$)"
    },
    "material_em_falta": {
      "type": "boolean",
      "default": false,
      "description": "Material em falta / a chegar \u2014 OP vai para aba 'OP sem Material'"
    },
    "material_espessura": {
      "type": "string",
      "description": "Espessura desejada informada manualmente (quando material em falta)"
    },
    "material_cor": {
      "type": "string",
      "description": "Cor desejada informada manualmente (quando material em falta)"
    },
    "foto_pedido_url": {
      "type": "string",
      "description": "URL da foto do pedido anexada"
    },
    "observacoes": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es ou observa\u00e7\u00f5es para o operador"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_producao",
        "pausado",
        "finalizado",
        "cancelado",
        "aguardando_material"
      ],
      "default": "pendente",
      "description": "Status da ordem"
    },
    "tempo_producao_seg": {
      "type": "number",
      "description": "Tempo acumulado em produ\u00e7\u00e3o (segundos)"
    },
    "tempo_pausa_seg": {
      "type": "number",
      "description": "Tempo acumulado em pausa (segundos)"
    },
    "tempo_setup_seg": {
      "type": "number",
      "description": "Tempo acumulado em setup (segundos)"
    },
    "inicio_producao_ts": {
      "type": "string",
      "description": "Timestamp ISO de in\u00edcio da sess\u00e3o de produ\u00e7\u00e3o atual"
    },
    "inicio_pausa_ts": {
      "type": "string",
      "description": "Timestamp ISO de in\u00edcio da pausa atual"
    },
    "motivo_pausa": {
      "type": "string",
      "description": "Motivo da pausa: 'setup' ou texto livre"
    },
    "historico_pausas": {
      "type": "string",
      "description": "JSON string com hist\u00f3rico de pausas [{motivo, inicio, fim, segundos}]"
    },
    "foto_etiqueta_bobina_url": {
      "type": "string",
      "description": "URL da foto da etiqueta da bobina (valida\u00e7\u00e3o ao iniciar produ\u00e7\u00e3o)"
    },
    "validacao_etiqueta_status": {
      "type": "string",
      "enum": [
        "aprovado",
        "rejeitado"
      ],
      "description": "Status da valida\u00e7\u00e3o da etiqueta da bobina ao iniciar"
    },
    "validacao_etiqueta_motivo": {
      "type": "string",
      "description": "Motivo retornado pela valida\u00e7\u00e3o da etiqueta"
    },
    "foto_finalizacao_url": {
      "type": "string",
      "description": "URL da foto tirada na finaliza\u00e7\u00e3o (obrigat\u00f3ria)"
    },
    "peso_real_balanca_kg": {
      "type": "number",
      "description": "Peso real do fardo aferido na balan\u00e7a f\u00edsica (kg)"
    },
    "data_finalizacao": {
      "type": "string",
      "format": "date",
      "description": "Data de finaliza\u00e7\u00e3o"
    },
    "is_retrabalho": {
      "type": "boolean",
      "default": false,
      "description": "Indica se esta ordem \u00e9 um retrabalho gerado a partir de outra"
    },
    "retrabalho_motivo": {
      "type": "string",
      "description": "Motivo do retrabalho (por que precisa ser refeito)"
    },
    "retrabalho_foto_1_url": {
      "type": "string",
      "description": "URL da primeira foto do retrabalho"
    },
    "retrabalho_foto_2_url": {
      "type": "string",
      "description": "URL da segunda foto do retrabalho"
    },
    "retrabalho_origem_id": {
      "type": "string",
      "description": "ID da ordem original que gerou este retrabalho"
    },
    "retrabalho_quantidade": {
      "type": "number",
      "description": "Quantidade de pe\u00e7as a reproduzir no retrabalho (n\u00e3o pode exceder a original)"
    },
    "retrabalho_etapa": {
      "type": "number",
      "description": "Etapa do retrabalho (1, 2, 3...) para diferencia\u00e7\u00e3o visual de cor",
      "default": 1
    },
    "retrabalho_bobina_sub_id": {
      "type": "string",
      "description": "ID da bobina substituta (quando a original est\u00e1 zerada)"
    },
    "retrabalho_bobina_sub_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da bobina substituta"
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "OP priorit\u00e1ria \u2014 fixada no topo e bloqueia in\u00edcio de outras OPs at\u00e9 ser finalizada"
    },
    "prioridade_nivel": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "N\u00edvel de prioridade de 1 (mais urgente) a 5 (baixa prioridade)"
    },
    "tipo_prioridade": {
      "type": "string",
      "description": "Tipo de prioridade herdado do pedido (Cliente Retira, Rota, Prioridade)"
    },
    "prioridade_logistica": {
      "type": "string",
      "description": "Prioridade log\u00edstica herdada do pedido"
    },
    "prioridade_selecionada": {
      "type": "boolean",
      "default": false,
      "description": "Indica que a prioridade j\u00e1 foi definida no PCP antes da distribui\u00e7\u00e3o"
    },
    "data_programada_pcp": {
      "type": "string",
      "description": "Data programada pelo PCP para produ\u00e7\u00e3o"
    },
    "rota": {
      "type": "boolean",
      "default": false,
      "description": "Ordem de rota de entrega \u2014 destaque visual pulsante no topo"
    },
    "is_rota": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicando que a ordem \u00e9 de rota"
    },
    "cliente_retira_agora": {
      "type": "boolean",
      "default": false,
      "description": "Cliente aguardando retirada imediata no balc\u00e3o"
    },
    "retira_agora": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicando retira imediata"
    },
    "rota_ts": {
      "type": "string",
      "description": "Timestamp ISO de quando a ordem foi marcada como rota"
    },
    "foto_carregamento_url": {
      "type": "string",
      "description": "URL da foto do carregamento no caminh\u00e3o"
    },
    "status_expedicao": {
      "type": "string",
      "enum": [
        "aguardando",
        "carregado",
        "em_transito",
        "expedido"
      ],
      "default": "aguardando",
      "description": "Status de expedi\u00e7\u00e3o/log\u00edstica"
    },
    "motorista_nome": {
      "type": "string",
      "description": "Nome do motorista que transportou"
    },
    "carga_id": {
      "type": "string",
      "description": "ID da Carga (caminh\u00e3o) vinculado"
    },
    "historico_expedicao": {
      "type": "string",
      "description": "JSON string com hist\u00f3rico de expedi\u00e7\u00e3o [{data, usuario, acao, detalhes}]"
    }
  },
  "required": [
    "data",
    "bobina_id",
    "quantidade"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "finalizado"
          }
        }
      },
      "then": {
        "required": [
          "foto_finalizacao_url"
        ]
      }
    }
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}