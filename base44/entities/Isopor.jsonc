{
  "name": "Isopor",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "EPS - TP 25",
        "EPS - TP 40",
        "EPS - TP 40 BANDEJA",
        "EPS - COLONIAL",
        "EPS - COLONIAL BANDEJA",
        "EPS - ONDULADO"
      ],
      "description": "Tipo do isopor"
    },
    "espessura_mm": {
      "type": "number",
      "description": "Espessura em mm"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade em estoque (unidades)"
    },
    "metragem_total": {
      "type": "number",
      "description": "Metragem total em metros (cada unidade = 2m)"
    },
    "nf": {
      "type": "string",
      "description": "Número da Nota Fiscal"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor do EPS / Isopor"
    },
    "anexo_nf_url": {
      "type": "string",
      "description": "URL do anexo da NF"
    },
    "anexo_nf_nome": {
      "type": "string",
      "description": "Nome do arquivo da NF"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações adicionais"
    }
  },
  "required": [
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}