{
  "name": "ToleranciaEspessura",
  "type": "object",
  "properties": {
    "espessura_nominal": {
      "type": "string",
      "description": "Espessura nominal exigida pelo pedido Odoo (ex: 0,43 / 1,30 / 2,30)"
    },
    "min_aceitavel": {
      "type": "number",
      "description": "Espessura m\u00ednima aceit\u00e1vel em mm (inclusive)"
    },
    "max_aceitavel": {
      "type": "number",
      "description": "Espessura m\u00e1xima aceit\u00e1vel em mm (inclusive)"
    },
    "origem_exigida": {
      "type": "string",
      "enum": [
        "ambas",
        "Nacional",
        "Importado"
      ],
      "default": "ambas",
      "description": "Origem do a\u00e7o exigida para esta espessura (ambas = sem restri\u00e7\u00e3o)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se esta toler\u00e2ncia est\u00e1 ativa"
    }
  },
  "required": [
    "espessura_nominal",
    "min_aceitavel",
    "max_aceitavel"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}