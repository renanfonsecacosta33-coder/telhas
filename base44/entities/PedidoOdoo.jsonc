{
  "name": "PedidoOdoo",
  "type": "object",
  "properties": {
    "odoo_id": {
      "type": "string",
      "description": "ID externo no Odoo (sale.order id)"
    },
    "numero_pedido": {
      "type": "string",
      "description": "CHAVE \u00daNICA (Unique Key) \u2014 n\u00famero do pedido Odoo (ex: SO-2026-283427, S00559). O webhook odooWebhook faz upsert por este campo: se j\u00e1 existir, atualiza dados/fotos/itens; se n\u00e3o, cria. Nunca duplica."
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel"
    },
    "foto_pedido_url": {
      "type": "string",
      "description": "URL da foto/croqui do pedido enviado pelo Odoo (anexo_1_url) \u2014 v\u00ednculo autom\u00e1tico com a 'Foto do Pedido (Encarregado)' nos galp\u00f5es"
    },
    "anexo_1_url": {
      "type": "string",
      "description": "Anexo 1 do pedido Odoo (URL ou Base64 do croqui/desenho t\u00e9cnico)"
    },
    "anexo_2_url": {
      "type": "string",
      "description": "Anexo 2 do pedido Odoo (URL ou Base64 do croqui/desenho t\u00e9cnico)"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data prometida de produ\u00e7\u00e3o/entrega calculada via SLA"
    },
    "data_recebimento": {
      "type": "string",
      "description": "Timestamp ISO de recebimento do pedido (webhook Odoo)"
    },
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade/filial"
    },
    "status_pcp": {
      "type": "string",
      "enum": [
        "pendente_distribuicao",
        "distribuido",
        "em_producao",
        "concluido"
      ],
      "default": "pendente_distribuicao",
      "description": "Status do pedido na central PCP"
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "Pedido priorit\u00e1rio/urgente \u2014 exige Senha de Gestor (PIN 0000) para ativar. Fixado no topo da fila e bloqueia in\u00edcio de OPs normais nas m\u00e1quinas."
    },
    "percentual_concluido": {
      "type": "number",
      "default": 0,
      "description": "Percentual de conclus\u00e3o (0-100)"
    },
    "total_itens": {
      "type": "number",
      "default": 0,
      "description": "Total de itens de fabrica\u00e7\u00e3o"
    },
    "itens_telha_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens da categoria Telhas"
    },
    "itens_cd_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens de Corte e Dobra / Perfis / Chapas"
    },
    "itens_frisada_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens Frisadas (direcionados \u00e0 Expedi\u00e7\u00e3o)"
    },
    "espessuras_tags": {
      "type": "string",
      "description": "JSON text com lista de espessuras de chapa distintas [{espessura}]"
    },
    "itens_json": {
      "type": "string",
      "description": "JSON text com itens detalhados [{categoria, produto, medida, espessura, quantidade, concluido}] \u2014 checklist individual por item (Rule 4)"
    },
    "historico_log": {
      "type": "string",
      "description": "JSON text com log de auditoria [{data, usuario, acao, detalhes}]"
    }
  },
  "required": [
    "numero_pedido"
  ],
  "rls": {
    "create": true,
    "read": {},
    "update": {},
    "delete": {}
  }
}