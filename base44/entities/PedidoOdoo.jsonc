{
  "name": "PedidoOdoo",
  "type": "object",
  "properties": {
    "odoo_id": {
      "type": "string",
      "description": "ID externo no Odoo (sale.order id ou mrp.production id)"
    },
    "of_odoo_id": {
      "type": "string",
      "description": "CHAVE ÚNICA DA PRODUÇÃO — ID da Ordem de Fabricação (mrp.production) no Odoo (ex: 456, 489). Permite múltiplas OFs independentes no mesmo Pedido de Venda."
    },
    "of_nome": {
      "type": "string",
      "description": "Nome/código visível da OF no Odoo (ex: WH/MO/406632, OF 456)"
    },
    "numero_pedido": {
      "type": "string",
      "description": "Número do Pedido de Venda no Odoo (ex: SO-2026-283427, S00556, SO001). Identifica a venda comercial à qual a OF pertence."
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel"
    },
    "foto_pedido_url": {
      "type": "string",
      "description": "URL da foto/croqui do pedido enviado pelo Odoo (anexo_1_url) \u2014 v\u00ednculo autom\u00e1tico com a 'Foto do Pedido (Encarregado)' nos galp\u00f5es"
    },
    "anexo_1_url": {
      "type": "string",
      "description": "Anexo 1 do pedido Odoo (URL ou Base64 do croqui/desenho t\u00e9cnico)"
    },
    "anexo_2_url": {
      "type": "string",
      "description": "Anexo 2 do pedido Odoo (URL ou Base64 do croqui/desenho técnico)"
    },
    "anexo_3_url": {
      "type": "string",
      "description": "Anexo 3 do pedido Odoo (URL do croqui)"
    },
    "anexo_4_url": {
      "type": "string",
      "description": "Anexo 4 do pedido Odoo (URL do croqui)"
    },
    "anexo_5_url": {
      "type": "string",
      "description": "Anexo 5 do pedido Odoo (URL do croqui)"
    },
    "anexo_6_url": {
      "type": "string",
      "description": "Anexo 6 do pedido Odoo (URL do croqui)"
    },
    "anexo_7_url": {
      "type": "string",
      "description": "Anexo 7 do pedido Odoo (URL do croqui)"
    },
    "anexo_8_url": {
      "type": "string",
      "description": "Anexo 8 do pedido Odoo (URL do croqui)"
    },
    "anexo_9_url": {
      "type": "string",
      "description": "Anexo 9 do pedido Odoo (URL do croqui)"
    },
    "anexo_10_url": {
      "type": "string",
      "description": "Anexo 10 do pedido Odoo (URL do croqui)"
    },
    "identificacao_1": {
      "type": "string",
      "description": "Identificação 1 enviada pelo Odoo"
    },
    "identificacao_2": {
      "type": "string",
      "description": "Identificação 2 enviada pelo Odoo"
    },
    "descricao": {
      "type": "string",
      "description": "Observação geral da ordem"
    },
    "nova_of": {
      "type": "boolean",
      "description": "Indica se é uma nova OF enviada pelo Odoo"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data prometida de produ\u00e7\u00e3o/entrega calculada via SLA"
    },
    "data_recebimento": {
      "type": "string",
      "description": "Timestamp ISO de recebimento do pedido (webhook Odoo)"
    },
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade/filial fabril de produção responsável pelo pedido"
    },
    "empresa_venda": {
      "type": "string",
      "description": "Nome bruto da Empresa de Venda no Odoo (ex: AJL - Pinhais, AJL COMERCIO ATACADISTA...)"
    },
    "loja_venda": {
      "type": "string",
      "description": "Loja comercial de origem da venda normalizada (Matriz AJL, Pinhais, Ivaiporã, Ponta Grossa)"
    },
    "unidade_transferida_de": {
      "type": "string",
      "description": "Unidade anterior caso a ordem tenha sido transferida manualmente entre filiais pelo PCP"
    },
    "motivo_transferencia": {
      "type": "string",
      "description": "Motivo da transferência manual entre filiais registrado pelo encarregado do PCP"
    },
    "historico_transferencias": {
      "type": "string",
      "description": "JSON array com histórico de auditoria de transferências [{ data, de, para, usuario, motivo }]"
    },
    "status_pcp": {
      "type": "string",
      "enum": [
        "pendente_distribuicao",
        "distribuido",
        "em_producao",
        "concluido"
      ],
      "default": "pendente_distribuicao",
      "description": "Status do pedido na central PCP"
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "Pedido prioritário/urgente — exige Senha de Gestor (PIN 0000) para ativar. Fixado no topo da fila e bloqueia início de OPs normais nas máquinas."
    },
    "prioridade_nivel": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Nível de prioridade de 1 (mais urgente) a 5 (baixa prioridade)"
    },
    "percentual_concluido": {
      "type": "number",
      "default": 0,
      "description": "Percentual de conclus\u00e3o (0-100)"
    },
    "total_itens": {
      "type": "number",
      "default": 0,
      "description": "Total de itens de fabrica\u00e7\u00e3o"
    },
    "itens_telha_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens da categoria Telhas"
    },
    "itens_cd_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens de Corte e Dobra / Perfis / Chapas"
    },
    "itens_frisada_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens Frisadas (direcionados \u00e0 Expedi\u00e7\u00e3o)"
    },
    "espessuras_tags": {
      "type": "string",
      "description": "JSON text com lista de espessuras de chapa distintas [{espessura}]"
    },
    "itens_json": {
      "type": "string",
      "description": "JSON text com itens detalhados [{categoria, produto, medida, espessura, quantidade, concluido}] \u2014 checklist individual por item (Rule 4)"
    },
    "maquinas_json": {
      "type": "string",
      "description": "JSON array do estado de cada m\u00e1quina C&D [{nome, status (pendente|em_andamento|concluido), operador, inicio_ts, fim_ts}] \u2014 rastreamento por m\u00e1quina (Mini BI)"
    },
    "etapas_telha_json": {
      "type": "string",
      "description": "JSON array das etapas das Telhas [{nome, status (pendente|concluido), hora_ts}] \u2014 rastreamento de corte/colagem (Mini BI)"
    },
    "historico_log": {
      "type": "string",
      "description": "JSON text com log de auditoria [{data, usuario, acao, detalhes}]"
    }
  },
  "required": [
    "numero_pedido"
  ],
  "rls": {
    "create": true,
    "read": {},
    "update": {},
    "delete": {}
  }
}