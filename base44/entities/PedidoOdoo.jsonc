{
  "name": "PedidoOdoo",
  "type": "object",
  "properties": {
    "odoo_id": {
      "type": "string",
      "description": "ID externo no Odoo (sale.order id ou mrp.production id)"
    },
    "of_odoo_id": {
      "type": "string",
      "description": "CHAVE \u00daNICA DA PRODU\u00c7\u00c3O \u2014 ID da Ordem de Fabrica\u00e7\u00e3o (mrp.production) no Odoo (ex: 456, 489). Permite m\u00faltiplas OFs independentes no mesmo Pedido de Venda."
    },
    "of_nome": {
      "type": "string",
      "description": "Nome/c\u00f3digo vis\u00edvel da OF no Odoo (ex: WH/MO/406632, OF 456)"
    },
    "numero_pedido": {
      "type": "string",
      "description": "N\u00famero do Pedido de Venda no Odoo (ex: SO-2026-283427, S00556, SO001). Identifica a venda comercial \u00e0 qual a OF pertence."
    },
    "numero_oc": {
      "type": "string",
      "description": "N\u00famero da Ordem de Compra / Sub-n\u00famero do outro sistema (ex: OC-1234, 1234)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "vendedor_nome": {
      "type": "string",
      "description": "Nome do vendedor respons\u00e1vel"
    },
    "foto_pedido_url": {
      "type": "string",
      "description": "URL da foto/croqui do pedido enviado pelo Odoo (anexo_1_url) \u2014 v\u00ednculo autom\u00e1tico com a 'Foto do Pedido (Encarregado)' nos galp\u00f5es"
    },
    "anexo_1_url": {
      "type": "string",
      "description": "Anexo 1 do pedido Odoo (URL ou Base64 do croqui/desenho t\u00e9cnico)"
    },
    "anexo_2_url": {
      "type": "string",
      "description": "Anexo 2 do pedido Odoo (URL ou Base64 do croqui/desenho t\u00e9cnico)"
    },
    "anexo_3_url": {
      "type": "string",
      "description": "Anexo 3 do pedido Odoo (URL do croqui)"
    },
    "anexo_4_url": {
      "type": "string",
      "description": "Anexo 4 do pedido Odoo (URL do croqui)"
    },
    "anexo_5_url": {
      "type": "string",
      "description": "Anexo 5 do pedido Odoo (URL do croqui)"
    },
    "anexo_6_url": {
      "type": "string",
      "description": "Anexo 6 do pedido Odoo (URL do croqui)"
    },
    "anexo_7_url": {
      "type": "string",
      "description": "Anexo 7 do pedido Odoo (URL do croqui)"
    },
    "anexo_8_url": {
      "type": "string",
      "description": "Anexo 8 do pedido Odoo (URL do croqui)"
    },
    "anexo_9_url": {
      "type": "string",
      "description": "Anexo 9 do pedido Odoo (URL do croqui)"
    },
    "anexo_10_url": {
      "type": "string",
      "description": "Anexo 10 do pedido Odoo (URL do croqui)"
    },
    "identificacao_1": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o 1 enviada pelo Odoo"
    },
    "identificacao_2": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o 2 enviada pelo Odoo"
    },
    "descricao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o geral da ordem"
    },
    "nova_of": {
      "type": "boolean",
      "description": "Indica se \u00e9 uma nova OF enviada pelo Odoo"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data prometida de produ\u00e7\u00e3o/entrega calculada via SLA comercial"
    },
    "data_previsao_fabrica": {
      "type": "string",
      "format": "date",
      "description": "Data de previs\u00e3o calculada e reprogramada pela f\u00e1brica/PCP enviada ao Odoo"
    },
    "motivo_alteracao_prazo": {
      "type": "string",
      "description": "Justificativa informada pelo PCP para altera\u00e7\u00e3o do prazo fabril (ex: falta de mat\u00e9ria-prima, fila de m\u00e1quinas)"
    },
    "data_alteracao_prazo": {
      "type": "string",
      "description": "Data/hora ISO de quando o prazo fabril foi modificado"
    },
    "usuario_alteracao_prazo": {
      "type": "string",
      "description": "Nome do usu\u00e1rio do PCP que alterou a previs\u00e3o fabril"
    },
    "data_recebimento": {
      "type": "string",
      "description": "Timestamp ISO de recebimento do pedido (webhook Odoo)"
    },
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade/filial fabril de produ\u00e7\u00e3o respons\u00e1vel pelo pedido"
    },
    "empresa_venda": {
      "type": "string",
      "description": "Nome bruto da Empresa de Venda no Odoo (ex: AJL - Pinhais, AJL COMERCIO ATACADISTA...)"
    },
    "loja_venda": {
      "type": "string",
      "description": "Loja comercial de origem da venda normalizada (Matriz AJL, Pinhais, Ivaipor\u00e3, Ponta Grossa)"
    },
    "unidade_transferida_de": {
      "type": "string",
      "description": "Unidade anterior caso a ordem tenha sido transferida manualmente entre filiais pelo PCP"
    },
    "motivo_transferencia": {
      "type": "string",
      "description": "Motivo da transfer\u00eancia manual entre filiais registrado pelo encarregado do PCP"
    },
    "historico_transferencias": {
      "type": "string",
      "description": "JSON array com hist\u00f3rico de auditoria de transfer\u00eancias [{ data, de, para, usuario, motivo }]"
    },
    "status_pcp": {
      "type": "string",
      "enum": [
        "pendente_distribuicao",
        "distribuido",
        "em_producao",
        "concluido"
      ],
      "default": "pendente_distribuicao",
      "description": "Status do pedido na central PCP"
    },
    "retirado_manualmente_ts": {
      "type": "string",
      "description": "Timestamp ISO de quando a OF foi devolvida MANUALMENTE \u00e0 Central PCP (Retirar da Fila / Devolver ao PCP / Auditoria). Enquanto preenchido, o bot\u00e3o 'Distribuir Todos os Pendentes' preserva esta OF no PCP \u2014 s\u00f3 volta \u00e0 produ\u00e7\u00e3o por distribui\u00e7\u00e3o expl\u00edcita (que limpa este campo)."
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "Pedido priorit\u00e1rio/urgente \u2014 exige Senha de Gestor (PIN 0000) para ativar. Fixado no topo da fila e bloqueia in\u00edcio de OPs normais nas m\u00e1quinas."
    },
    "prioridade_nivel": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "N\u00edvel de prioridade de 1 (mais urgente) a 5 (baixa prioridade)"
    },
    "rota": {
      "type": "boolean",
      "default": false,
      "description": "Pedido de rota / carga programada de entrega"
    },
    "is_rota": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicando que o pedido \u00e9 de rota"
    },
    "rota_ts": {
      "type": "string",
      "description": "Timestamp ISO da marca\u00e7\u00e3o de rota"
    },
    "cliente_retira_agora": {
      "type": "boolean",
      "default": false,
      "description": "Cliente aguardando retirada imediata no balc\u00e3o"
    },
    "retira_agora": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicando retira imediata"
    },
    "percentual_concluido": {
      "type": "number",
      "default": 0,
      "description": "Percentual de conclus\u00e3o (0-100)"
    },
    "total_itens": {
      "type": "number",
      "default": 0,
      "description": "Total de itens de fabrica\u00e7\u00e3o"
    },
    "itens_telha_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens da categoria Telhas"
    },
    "itens_cd_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens de Corte e Dobra / Perfis / Chapas"
    },
    "itens_frisada_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens Frisadas (direcionados \u00e0 Expedi\u00e7\u00e3o)"
    },
    "espessuras_tags": {
      "type": "string",
      "description": "JSON text com lista de espessuras de chapa distintas [{espessura}]"
    },
    "itens_json": {
      "type": "string",
      "description": "JSON text com itens detalhados [{categoria, produto, medida, espessura, quantidade, concluido}] \u2014 checklist individual por item (Rule 4)"
    },
    "maquinas_json": {
      "type": "string",
      "description": "JSON array do estado de cada m\u00e1quina C&D [{nome, status (pendente|em_andamento|concluido), operador, inicio_ts, fim_ts}] \u2014 rastreamento por m\u00e1quina (Mini BI)"
    },
    "etapas_telha_json": {
      "type": "string",
      "description": "JSON array das etapas das Telhas [{nome, status (pendente|concluido), hora_ts}] \u2014 rastreamento de corte/colagem (Mini BI)"
    },
    "historico_log": {
      "type": "string",
      "description": "JSON text com log de auditoria [{data, usuario, acao, detalhes}]"
    }
  },
  "required": [
    "numero_pedido"
  ],
  "rls": {
    "create": true,
    "read": {},
    "update": {},
    "delete": {}
  }
}