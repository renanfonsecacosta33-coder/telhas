{
  "name": "Categoria",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "icone": {
      "type": "string",
      "description": "Nome do \u00edcone Lucide"
    },
    "path": {
      "type": "string",
      "description": "Rota da p\u00e1gina"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o na sidebar"
    },
    "ativa": {
      "type": "boolean",
      "description": "Se est\u00e1 vis\u00edvel na sidebar",
      "default": true
    },
    "cor": {
      "type": "string",
      "description": "Cor de destaque"
    }
  },
  "required": [
    "nome",
    "path"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}