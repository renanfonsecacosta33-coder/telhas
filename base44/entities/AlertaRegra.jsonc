{
  "name": "AlertaRegra",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome identificador do alerta (ex: Estoque Cr\u00edtico de Bobina)"
    },
    "evento": {
      "type": "string",
      "enum": [
        "estoque_baixo",
        "pedido_pronto",
        "reserva_vencida",
        "maquina_parada",
        "nova_op_prioritaria",
        "atraso_producao",
        "refugo_alto",
        "novo_usuario"
      ],
      "default": "estoque_baixo",
      "description": "Gatilho ou evento disparador do alerta"
    },
    "limite_kg": {
      "type": "number",
      "default": 1000,
      "description": "Limite em kg para alertas de estoque_baixo (opcional)"
    },
    "destinatarios_email": {
      "type": "string",
      "description": "E-mails separados por v\u00edrgula para notifica\u00e7\u00e3o"
    },
    "destinatarios_whatsapp": {
      "type": "string",
      "description": "N\u00fameros de WhatsApp (DDI+DDD+n\u00famero) separados por v\u00edrgula"
    },
    "som": {
      "type": "string",
      "enum": [
        "nenhum",
        "sirene.mp3",
        "caixa_registradora.mp3",
        "ding.mp3",
        "buzina.mp3",
        "alarme_industrial.mp3",
        "sucesso.mp3"
      ],
      "default": "nenhum",
      "description": "Som a ser reproduzido nas interfaces do galp\u00e3o/escrit\u00f3rio"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Indica se esta regra de alerta est\u00e1 ativa"
    }
  },
  "required": [
    "nome",
    "evento"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}