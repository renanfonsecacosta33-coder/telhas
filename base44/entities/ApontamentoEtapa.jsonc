{
  "name": "ApontamentoEtapa",
  "type": "object",
  "properties": {
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade/filial"
    },
    "setor": {
      "type": "string",
      "enum": [
        "telhas",
        "corte_dobra"
      ],
      "description": "Setor (telhas ou corte e dobra)"
    },
    "ordem_id": {
      "type": "string",
      "description": "ID da OP vinculada (Pedido / OrdemDesbobinadeira / OrdemMaquinaCD)"
    },
    "ordem_tipo": {
      "type": "string",
      "enum": [
        "telhas",
        "desbobinadeira",
        "maquina_cd"
      ],
      "description": "Tipo da OP vinculada"
    },
    "numero_pedido": {
      "type": "string",
      "description": "N\u00famero do pedido (snapshot)"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente (snapshot)"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "desbobinadeira",
        "perfilagem",
        "qualidade",
        "carregamento"
      ],
      "description": "Etapa de produ\u00e7\u00e3o apontada"
    },
    "etapa_label": {
      "type": "string",
      "description": "R\u00f3tulo leg\u00edvel da etapa (snapshot)"
    },
    "is_etapa_final": {
      "type": "boolean",
      "default": false,
      "description": "Indica se \u00e9 a etapa final (Carregamento) \u2014 dispara a gera\u00e7\u00e3o do PDF final"
    },
    "operador_nome": {
      "type": "string",
      "description": "Nome do operador que assinou"
    },
    "operador_id": {
      "type": "string",
      "description": "ID do operador"
    },
    "maquina": {
      "type": "string",
      "description": "M\u00e1quina utilizada na etapa (snapshot)"
    },
    "data_hora": {
      "type": "string",
      "description": "Timestamp ISO exato do apontamento"
    },
    "pecas_produzidas": {
      "type": "number",
      "description": "Pe\u00e7as produzidas na etapa"
    },
    "metros_reais": {
      "type": "number",
      "description": "Metragem real produzida (m)"
    },
    "refuga_kg": {
      "type": "number",
      "description": "Refuga / perda (kg)"
    },
    "assinatura_url": {
      "type": "string",
      "description": "URL da imagem da assinatura digital (PNG)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do operador"
    },
    "pdf_final_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o PDF final da OP j\u00e1 foi gerado a partir desta etapa"
    },
    "pdf_final_url": {
      "type": "string",
      "description": "URL do PDF final sincronizado (Documento Vivo)"
    }
  },
  "required": [
    "ordem_id",
    "ordem_tipo",
    "etapa",
    "operador_nome",
    "data_hora"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}