{
  "name": "ModeloProduto",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "enum": [
        "TELHA",
        "TELHA + EPS",
        "TELHA + EPS + MANTA",
        "TELHA + EPS + TELHA",
        "TELHA BANDEJA",
        "BOBININHA",
        "CUMEEIRA",
        "PAINEL"
      ],
      "description": "Tipo de produto"
    },
    "modelo": {
      "type": "string",
      "description": "Nome do modelo (ex: TP-40 RVM, Colonial 500mm)"
    },
    "maquinas": {
      "type": "string",
      "description": "M\u00e1quinas que fazem este modelo (ex: TP-25, TP-40)"
    },
    "espessuras": {
      "type": "string",
      "description": "Espessuras dispon\u00edveis (ex: 0,43 / 0,50 / 0,65)"
    },
    "meta_min_metros": {
      "type": "number",
      "description": "Meta mínima diária em metros lineares para este modelo"
    },
    "meta_max_metros": {
      "type": "number",
      "description": "Meta máxima diária (capacidade de agendamento) em metros lineares para este modelo"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o modelo está ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações adicionais"
    }
  },
  "required": [
    "produto",
    "modelo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}