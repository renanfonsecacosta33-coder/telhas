{
  "name": "ProducaoDiaria",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da produ\u00e7\u00e3o"
    },
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "description": "Unidade produtora"
    },
    "bobina_id": {
      "type": "string",
      "description": "ID da bobina em uso"
    },
    "bobina_codigo": {
      "type": "string",
      "description": "C\u00f3digo da bobina (para refer\u00eancia)"
    },
    "bobina_cor": {
      "type": "string",
      "description": "Cor da bobina"
    },
    "metros_perfiladeira": {
      "type": "number",
      "description": "Metros tirados na perfiladeira"
    },
    "metros_colagem": {
      "type": "number",
      "description": "Metros tirados na colagem"
    },
    "metros_total": {
      "type": "number",
      "description": "Total de metros produzidos"
    },
    "telha_simples": {
      "type": "number",
      "description": "Telha simples (m)"
    },
    "telha_eps": {
      "type": "number",
      "description": "Telha + EPS (m)"
    },
    "telha_eps_manta": {
      "type": "number",
      "description": "Telha + EPS + Manta (m)"
    },
    "telha_eps_telha": {
      "type": "number",
      "description": "Telha + EPS + Telha (m)"
    },
    "telha_bandeja": {
      "type": "number",
      "description": "Telha Bandeja (m)"
    },
    "bobininha": {
      "type": "number",
      "description": "Bobininha (m)"
    },
    "cumeeira": {
      "type": "number",
      "description": "Cumeeira (m)"
    },
    "painel": {
      "type": "number",
      "description": "Painel (m)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "data",
    "unidade"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}