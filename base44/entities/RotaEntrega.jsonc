{
  "name": "RotaEntrega",
  "type": "object",
  "properties": {
    "unidade": {
      "type": "string",
      "enum": [
        "Matriz AJL",
        "Pinhais",
        "Ivaipor\u00e3",
        "Ponta Grossa"
      ],
      "default": "Matriz AJL",
      "description": "Unidade/filial de origem da rota"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da rota (ex: ROTA DE ENTREGA PONTA GROSSA - EDUARDO)"
    },
    "rota_imagem_url": {
      "type": "string",
      "description": "URL da imagem da rota de entrega (manifesto)"
    },
    "rota_imagem_nome": {
      "type": "string",
      "description": "Nome do arquivo da imagem da rota"
    },
    "entrega_date": {
      "type": "string",
      "description": "Data de entrega (campo ENTREGA do manifesto)"
    },
    "embarque_date": {
      "type": "string",
      "description": "Data de embarque (campo EMBARQUE do manifesto)"
    },
    "total_valor": {
      "type": "string",
      "description": "Valor total da rota (ex: R$ 26.984,66)"
    },
    "nota_geral": {
      "type": "string",
      "description": "Nota/observa\u00e7\u00e3o geral extra\u00edda do rodap\u00e9 do manifesto"
    },
    "itens_json": {
      "type": "string",
      "description": "JSON com lista de pedidos lidos pela IA [{ordem, numero_pedido, cliente, vendedor, bairro, pagamento, valor, observacao, departamentos: [telhas, corte_dobra, expedicao]}]"
    },
    "observacao": {
      "type": "string",
      "description": "OBS \u2014 observa\u00e7\u00f5es adicionais preenchidas pela log\u00edstica"
    },
    "imagem_carregamento_url": {
      "type": "string",
      "description": "URL da foto de carregamento do caminh\u00e3o (legado \u2014 uso \u00fanico antigo)"
    },
    "imagem_carregamento_nome": {
      "type": "string",
      "description": "Nome do arquivo da imagem de carregamento (legado)"
    },
    "imagem_carregamento_telhas_url": {
      "type": "string",
      "description": "URL da foto de carregamento do barrac\u00e3o de Telhas"
    },
    "imagem_carregamento_telhas_nome": {
      "type": "string",
      "description": "Nome do arquivo da foto de carregamento \u2014 Telhas"
    },
    "imagem_carregamento_corte_dobra_url": {
      "type": "string",
      "description": "URL da foto de carregamento do barrac\u00e3o de Corte e Dobra"
    },
    "imagem_carregamento_corte_dobra_nome": {
      "type": "string",
      "description": "Nome do arquivo da foto de carregamento \u2014 Corte e Dobra"
    },
    "imagem_carregamento_expedicao_url": {
      "type": "string",
      "description": "URL da foto de carregamento do barrac\u00e3o de Expedi\u00e7\u00e3o"
    },
    "imagem_carregamento_expedicao_nome": {
      "type": "string",
      "description": "Nome do arquivo da foto de carregamento \u2014 Expedi\u00e7\u00e3o"
    },
    "motorista_nome": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "placa": {
      "type": "string",
      "description": "Placa do caminh\u00e3o"
    },
    "transportadora": {
      "type": "string",
      "description": "Nome da transportadora"
    },
    "status": {
      "type": "string",
      "enum": [
        "distribuido",
        "carregado",
        "em_transito",
        "expedido",
        "cancelado"
      ],
      "default": "distribuido",
      "description": "Status da rota de entrega (expedido = arquivada/finalizada)"
    },
    "data_criacao": {
      "type": "string",
      "format": "date",
      "description": "Data de cria\u00e7\u00e3o da rota"
    },
    "data_finalizacao": {
      "type": "string",
      "description": "Timestamp ISO de quando a rota foi arquivada/finalizada"
    },
    "criado_por": {
      "type": "string",
      "description": "Nome de quem criou a rota"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}