{
  "name": "DadosProducao",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "vendedor",
        "rvm",
        "maquinario",
        "eps"
      ],
      "description": "Tipo de dado"
    },
    "valor": {
      "type": "string",
      "description": "Valor do dado (nome do vendedor, cor RVM, nome do maquin\u00e1rio, tipo de EPS)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o adicional"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    }
  },
  "required": [
    "tipo",
    "valor"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "gestor"
          }
        }
      ]
    }
  }
}